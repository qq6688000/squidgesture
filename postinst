#!/bin/sh
set -e

JB=/var/jb
[ -d "$JB" ] || JB=""

DYLIB="$JB/Library/MobileSubstrate/DynamicLibraries/SquidGesture.dylib"
PLIST="$JB/Library/MobileSubstrate/DynamicLibraries/SquidGesture.plist"
TI="$JB/usr/lib/TweakInject"

chmod 755 "$DYLIB" 2>/dev/null || true

if [ -d "$TI" ] && [ -f "$DYLIB" ] && [ ! -e "$TI/SquidGesture.dylib" ]; then
    ln -sf "$DYLIB" "$TI/SquidGesture.dylib" 2>/dev/null || true
    ln -sf "$PLIST" "$TI/SquidGesture.plist" 2>/dev/null || true
fi

# Write default preferences, keeping any existing user config untouched
PREFS="/var/mobile/Library/Preferences/com.minis.squidgesture.plist"
if [ ! -f "$PREFS" ]; then
    mkdir -p "$(dirname "$PREFS")"
    cat > "$PREFS" <<'PLISTEOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Enabled</key><true/>
    <key>CornerSize</key><real>80</real>
    <key>LeftEdgeBack</key><true/>
    <key>RightEdgeSwitcher</key><true/>
    <key>CornerTapLock</key><true/>
    <key>CornerTapScreenshot</key><true/>
    <key>ThreeFingerHome</key><true/>
    <key>ThreeFingerSwitcher</key><true/>
    <key>VibrationFeedback</key><true/>
    <key>PanelEnabled</key><true/>
    <key>PanelVibrate</key><true/>
    <key>PanelPrewarm</key><true/>
    <key>PanelPrewarmLimit</key><integer>4</integer>
    <key>PanelBarTolerance</key><real>28</real>
    <key>PanelBarPad</key><real>34</real>
    <key>PanelApps</key>
    <array>
        <string>com.apple.MobileSMS</string>
        <string>com.apple.mobilesafari</string>
        <string>com.apple.camera</string>
        <string>com.apple.mobiletimer</string>
        <string>com.apple.mobilenotes</string>
        <string>com.apple.calculator</string>
    </array>
</dict>
</plist>
PLISTEOF
    chown mobile:mobile "$PREFS" 2>/dev/null || true
fi

killall -9 SpringBoard 2>/dev/null || true

echo "SquidGesture 1.6.1 installed."
echo ""
echo "  Swipe up from the BOTTOM-RIGHT corner -> app panel (+ to add apps)"
echo "  Left edge swipe    -> Back        Right edge swipe -> App switcher"
echo "  Top-left 2x tap    -> Lock        Top-right 2x tap -> Screenshot"
echo "  3-finger up        -> Home        3-finger down    -> App switcher"
echo ""
echo "Manual panel test (no gesture needed):"
echo "  notify_post com.minis.squidgesture.test.panel"
echo ""
echo "Config: /var/mobile/Library/Preferences/com.minis.squidgesture.plist"
echo "Log:    /var/mobile/Library/Preferences/com.minis.squidgesture.log"
exit 0
