#!/bin/sh
# preinst: runs BEFORE dpkg unpacks files.
#
# The device ended up with a self-referential symlink:
#   DynamicLibraries/SquidGesture.dylib -> .../DynamicLibraries/SquidGesture.dylib
# which destroyed the real dylib and made every install a no-op.  Remove any
# symlink at the managed paths (never a regular file - dpkg overwrites those
# fine) so dpkg can write clean real files.
JB=/var/jb
[ -d "$JB" ] || JB=""

DL="$JB/Library/MobileSubstrate/DynamicLibraries"
TI="$JB/usr/lib/TweakInject"

for d in "$DL" "$TI"; do
    [ -d "$d" ] || continue
    for f in SquidGesture.dylib SquidGesture.plist; do
        p="$d/$f"
        [ -L "$p" ] && rm -f "$p" 2>/dev/null
    done
done
exit 0
